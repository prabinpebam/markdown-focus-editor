{
  "name": "markdown-focus-editor",
  "version": "1.0.0",
  "description": "A simple, distraction-free Markdown editor built with Electron, focusing on one heading section at a time.",
  "main": "electron/main.js",
  "author": "Prabin Pebam",
  "license": "ISC",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:portable": "electron-builder",
    "test": "npx playwright test",
    "eval": "npx playwright test --reporter=list",
    "eval:headed": "npx playwright test --headed --reporter=list",
    "generate-icon": "node build/generate-icon.js"
  },
  "build": {
    "appId": "com.prabinpebam.markdown-focus-editor",
    "productName": "MarkdownFocusEditor",
    "directories": {
      "output": "dist"
    },
    "portable": {
      "artifactName": "MarkdownFocusEditor.exe",
      "requestExecutionLevel": "user",
      "unpackDirName": "MarkdownFocusEditor-Runtime"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico"
    },
    "electronLanguages": ["en-US"],
    "files": [
      "electron/**/*",
      "js/**/*",
      "style/**/*",
      "images/**/*",
      "index.html",
      "build/icon.ico",
      "!**/eval-loop",
      "!**/test-results",
      "!**/*.spec.js"
    ],
    "extraResources": [],
    "asar": true,
    "asarUnpack": [
      "style/fonts/**"
    ],
    "removePackageScripts": true
  },
  "keywords": [],
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "electron": "^41.2.0",
    "electron-builder": "^26.8.1",
    "png-to-ico": "^3.0.1",
    "serve": "^14.2.6",
    "sharp": "^0.34.5"
  }
}
